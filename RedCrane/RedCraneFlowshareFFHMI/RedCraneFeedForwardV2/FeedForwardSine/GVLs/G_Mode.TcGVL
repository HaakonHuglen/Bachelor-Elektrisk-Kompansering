    // ── Sylinderaktivering ──────────────────────────
    bJibActive       : BOOL := TRUE;   // Jib aktiv (kan kombineres med Main)
    bMainActive      : BOOL := FALSE;  // Main aktiv (kan kombineres med Jib)

    // ── Kjøretilstand ─────────────────────────────────────────────────
