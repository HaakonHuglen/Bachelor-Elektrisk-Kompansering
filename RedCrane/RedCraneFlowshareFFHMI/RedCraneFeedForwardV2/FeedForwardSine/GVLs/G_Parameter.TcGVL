  <GVL Name="G_Parameter" Id="{20ea7e22-ac41-46d0-8f27-3ff6735f0cc1}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
    // ===== JIB CYLINDER (ø150/ø100, stroke 855 mm) =====
    fJib_AreaA      : LREAL := 0.01767146;
